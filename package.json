		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node20": "^20.1.2",
		"@types/node": "~24.1.0",
		"@types/ws": "^8.18.1",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"tsx": "^4.20.5",
		"typescript": "^5.2.2"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.0",
		"ws": "^8.18.3"
